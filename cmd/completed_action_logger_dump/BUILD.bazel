load("@com_github_buildbarn_bb_storage//tools:container.bzl", "multiarch_go_image")
load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("@rules_img//img:load.bzl", "image_load")

go_library(
    name = "completed_action_logger_dump_lib",
    srcs = ["main.go"],
    importpath = "github.com/buildbarn/bb-portal/cmd/completed_action_logger_dump",
    visibility = ["//visibility:private"],
    deps = [
        "@com_github_buildbarn_bb_remote_execution//pkg/proto/completedactionlogger",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_protobuf//encoding/protojson",
        "@org_golang_google_protobuf//types/known/emptypb",
    ],
)

go_binary(
    name = "completed_action_logger_dump",
    embed = [":completed_action_logger_dump_lib"],
    visibility = ["//visibility:public"],
)

multiarch_go_image(
    name = "completed_action_logger_dump_container",
    binary = ":completed_action_logger_dump",
)

image_load(
    name = "completed_action_logger_dump_container_load",
    image = ":completed_action_logger_dump_container",
    tag = "bb-portal/completed-action-logger-dump:local",
    visibility = ["//visibility:public"],
)
