load("@rules_go//go:def.bzl", "go_binary", "go_test")
load("@rules_itest//:itest.bzl", "itest_service", "named_port", "service_test")

go_binary(
    name = "bb_portal_itest_service",
    srcs = ["bb_portal_itest_service.go"],
    data = ["//cmd/bb_portal"],
    deps = [
        "//internal/database/embedded",
        "@rules_go//go/runfiles",
    ],
)

go_binary(
    name = "graphql_healthcheck",
    srcs = ["graphql_healthcheck.go"],
)

itest_service(
    name = "bb_portal",
    args = [
        "-http-port",
        named_port(":bb_portal", "http"),
        "-bes-port",
        named_port(":bb_portal", "bes"),
        "-cal-port",
        named_port(":bb_portal", "cal"),
        "-diagnostics-port",
        named_port(":bb_portal", "diagnostics"),
    ],
    exe = ":bb_portal_itest_service",
    health_check = ":graphql_healthcheck",
    health_check_args = [
        "-http-port",
        named_port(":bb_portal", "http"),
    ],
    health_check_interval = "500ms",
    health_check_timeout = "60s",
    named_ports = [
        "http",
        "bes",
        "cal",
        "diagnostics",
    ],
    shutdown_timeout = "30s",
)

go_test(
    name = "_completed_action_ingestion_test",
    srcs = ["completed_action_ingestion_test.go"],
    data = ["//test/integrationtest:nextjs_test_bep"],
    tags = ["manual"],
    deps = [
        "//pkg/proto/bazelbuild/bazel/bes:build_event_stream",
        "@bazel_remote_apis//build/bazel/remote/execution/v2:remote_execution_go_proto",
        "@com_github_buildbarn_bb_remote_execution//pkg/proto/cas",
        "@com_github_buildbarn_bb_remote_execution//pkg/proto/completedactionlogger",
        "@com_github_stretchr_testify//require",
        "@org_golang_google_genproto//googleapis/devtools/build/v1:build",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//credentials/insecure",
        "@org_golang_google_protobuf//encoding/protojson",
        "@org_golang_google_protobuf//types/known/anypb",
        "@org_golang_google_protobuf//types/known/timestamppb",
        "@rules_go//go/runfiles",
    ],
)

service_test(
    name = "completed_action_ingestion_test",
    services = [":bb_portal"],
    test = ":_completed_action_ingestion_test",
)

go_test(
    name = "buildbarn_itest_test",
    srcs = ["completed_action_ingestion_test.go"],
    deps = [
        "//pkg/proto/bazelbuild/bazel/bes:build_event_stream",
        "@bazel_remote_apis//build/bazel/remote/execution/v2:remote_execution_go_proto",
        "@com_github_buildbarn_bb_remote_execution//pkg/proto/cas",
        "@com_github_buildbarn_bb_remote_execution//pkg/proto/completedactionlogger",
        "@com_github_stretchr_testify//require",
        "@org_golang_google_genproto//googleapis/devtools/build/v1:build",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//credentials/insecure",
        "@org_golang_google_protobuf//encoding/protojson",
        "@org_golang_google_protobuf//types/known/anypb",
        "@org_golang_google_protobuf//types/known/timestamppb",
        "@rules_go//go/runfiles",
    ],
)
